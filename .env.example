# ==========================================
# AZHost Environment Configuration Template
# ==========================================

# Database Configuration
POSTGRES_DB=azhost
POSTGRES_USER=azhost_user
POSTGRES_PASSWORD=azhost_password
DATABASE_URL=jdbc:postgresql://postgres:5432/azhost
DATABASE_USERNAME=azhost_user
DATABASE_PASSWORD=azhost_password

# Backend Application Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Frontend Configuration
VITE_API_URL=http://localhost:8080

# Build Hardening (Phase 8)
AZHOST_MAX_CONCURRENT_BUILDS=2
AZHOST_BUILD_QUEUE_CAPACITY=50
AZHOST_BUILD_TIMEOUT_SECONDS=600
AZHOST_BUILD_MAX_RETRIES=2
AZHOST_BUILD_CPU_LIMIT=2.0
AZHOST_BUILD_MEMORY_LIMIT=2048m
AZHOST_BUILD_PIDS_LIMIT=100
AZHOST_DEPLOYMENT_TIMEOUT_SECONDS=300
AZHOST_DEPLOYMENT_RETENTION_MAX=20
AZHOST_RATE_LIMIT_ENABLED=true
AZHOST_RATE_LIMIT_RPM=60
